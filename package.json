{
  "name": "dsh-world-engine",
  "version": "0.1.0",
  "description": "世界引擎（dsh-world-engine）：DSH 插件。引擎本体随包交付，插件加载时自动拉起并看门狗托管在本机 127.0.0.1:32100，设置页提供世界概览、演化规则、NPC 与地点、预置/运行时记忆、重大节点审批（QQ 私聊回执）、时间线事件与备份回滚。安装后开箱即用，已有存档沿用不重建。",
  "license": "MIT",
  "author": "豆包 AI（代码与实现）",
  "contributors": [
    {
      "name": "仓库作者",
      "role": "内容架构与世界设定"
    }
  ],
  "type": "module",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.2"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "world-engine",
    "companion",
    "persistent-world"
  ],
  "main": "lib/host.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "engine",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "node": ">=22"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "世界引擎",
    "summary": "本地持久世界的设置面板：世界时间与主角状态、演化规则与开关、自主 NPC 管理、重大节点审批（可联动 QQ 私聊回执）、近期事件与快照备份/回滚。",
    "categories": [
      "陪伴",
      "世界设定",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:world-engine-proxy"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.2 <0.3.0-0",
      "node": ">=22"
    },
    "permissions": {
      "network": [
        "http://127.0.0.1:32100",
        "http://localhost:32100"
      ]
    }
  }
}
